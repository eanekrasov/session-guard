{
  "name": "opencode-state-machine",
  "version": "0.1.0",
  "description": "State machine library for OpenCode plugins — gives schema-based workflow with strict validation between steps",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "state-machine",
    "workflow",
    "agent"
  ],
  "license": "MIT",
  "author": {
    "name": "OpenCode AI",
    "email": "dev@opencode.ai"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/opencode-ai/profile-config"
  },
  "bugs": {
    "url": "https://github.com/opencode-ai/profile-config/issues"
  },
  "homepage": "https://github.com/opencode-ai/profile-config#readme",
  "engines": {
    "opencode": ">=0.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "scripts/commit-task.ts",
    "README.md"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.25",
    "@opentui/core": "^0.5.9",
    "@opentui/keymap": "^0.5.9",
    "@opentui/solid": "^0.5.9",
    "@tsconfig/bun": "^1.0.11",
    "minimatch": "^10.2.6",
    "solid-js": "^1.9.15",
    "yaml": "^2.9.0",
    "zod": "^3",
    "zod-to-json-schema": "^3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "8.47.0",
    "@typescript-eslint/parser": "8.47.0",
    "bun-types": "latest",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.4",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.2.4"
  }
}
