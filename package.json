{
  "name": "@eanekrasov/session-guard",
  "version": "0.2.3",
  "description": "Session guard for OpenCode — gives schema-based workflow with strict validation between steps",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "session-guard",
    "workflow",
    "agent",
    "tui"
  ],
  "license": "MIT",
  "author": {
    "name": "e.nekrasov",
    "email": "e.nekrasov@crpt.ru"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "session-guard": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/plugin.js",
      "types": "./dist/plugin.d.ts"
    },
    "./server": {
      "import": "./dist/plugin.js",
      "types": "./dist/plugin.d.ts"
    },
    "./v2": {
      "import": "./dist/v2/plugin.js",
      "types": "./dist/v2/plugin.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eanekrasov/session-guard"
  },
  "bugs": {
    "url": "https://github.com/eanekrasov/session-guard/issues"
  },
  "homepage": "https://github.com/eanekrasov/session-guard#readme",
  "engines": {
    "opencode": ">=1.18.29"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "chat.message",
      "chat.params",
      "event"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "package.json"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.34",
    "@opencode/plugin": "2.0.22",
    "@opentui/core": "^0.5.14",
    "@opentui/keymap": "^0.5.14",
    "@opentui/solid": "^0.5.14",
    "@tsconfig/bun": "^1.0.11",
    "minimatch": "^10.2.6",
    "solid-js": "^1.9.15",
    "yaml": "^2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jclem/logfmt2": "2.4.3",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "bun-types": "latest",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jsmin": "1.0.1",
    "prettier": "^3.2.4",
    "typescript-eslint": "^8.71.0",
    "vitest": "5.0.3"
  }
}
