#!/usr/bin/env bash
#MISE description="Build the project"
#MISE depends=["setup"]
#MISE sources=["src/**/*", "scripts/build-tui.ts", "scripts/build-schema.ts", "scripts/verify-build.ts"]
#MISE outputs=["dist/index.js","dist/cli.js","dist/tui.js","dist/index.d.ts","dist/tui.d.ts","dist/profile.schema.json","dist/profile-schema.schema.json"]

set -euo pipefail

# Hermetic build: emit from nothing. Without this a deleted source leaves its
# declaration behind in the published package — `tsc --emitDeclarationOnly`
# adds files, it never removes the ones whose source is gone.
rm -rf dist

bun build ./src/index.ts ./src/cli.ts --outdir dist --target bun
bun scripts/build-tui.ts
bun scripts/build-schema.ts
tsc -p tsconfig.decl.json
bun scripts/verify-build.ts
