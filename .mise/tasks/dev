#!/usr/bin/env bash
#MISE description="Build for development with sourcemaps and vendor splitting"
#MISE sources=["src/**/*"]
#MISE outputs=["dist/plugin.js"]

bun build ./src/plugin.ts \
  --outdir dist \
  --target bun \
  --sourcemap=inline \
  --splitting \
  --entry-naming='[dir]/[name].js' \
  --chunk-naming='[name].[hash].js'
