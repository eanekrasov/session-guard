{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    // In-repo profiles import the package by its published name — that is the
    // contract for profile authors. Without this mapping TypeScript resolves it
    // through the package's own `exports` to `dist/index.d.ts`, needs a project
    // root to map that output back to a source, and fails with TS2209 because
    // `rootDir` is unset here. Mapping to the source keeps `check` build-free.
    "paths": {
      "@eanekrasov/session-guard": ["./src/index.ts"]
    },
    "outDir": "dist",
    "declaration": false,
    "types": ["bun-types"],

    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/solid",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "scripts/**/*.ts", "smoke/**/*.ts"],
  "exclude": ["profiles/**/*.ts"]
}
